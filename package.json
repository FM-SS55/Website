{
  "name": "pulizia-fm",
  "version": "2.0.0",
  "private": true,
  "description": "Pulizia FM Services \u2014 website, admin panel and API",
  "workspaces": [
    "backend",
    "frontend/web",
    "frontend/admin"
  ],
  "scripts": {
    "dev": "concurrently -n api,web,admin -c blue,green,magenta \"npm:dev:backend\" \"npm:dev:web\" \"npm:dev:admin\"",
    "dev:backend": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend/web",
    "dev:admin": "npm run dev -w frontend/admin",
    "build": "npm run build -w frontend/web && npm run build -w frontend/admin",
    "migrate": "npm run migrate -w backend",
    "start": "npm run start -w backend",
    "test": "npm test -w backend",
    "package:cpanel": "node devops/scripts/package-cpanel.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}