# Used by docker-compose (backend reads it via env_file) and as a reference for local dev.
# For local dev without Docker, copy backend/.env.example to backend/.env instead.
SESSION_SECRET=replace_with_a_long_random_string
ADMIN_USER=admin
ADMIN_PASS=change_me_before_deploy
MAX_UPLOAD_MB=5
HTTP_PORT=80
# NOTE: in production the session cookie is Secure, so serve the site over HTTPS.
